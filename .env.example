# Use images built from this fixed revision; old published images do not implement Unix control.
RUSTDESK_IMAGE_TAG=audit-fixed
RUSTDESK_HOST=example.com
RUSTDESK_API_URL=https://example.com
TZ=Asia/Shanghai
# Required: generate using openssl rand -hex 32. Same key for hbbs and API.
RUSTDESK_API_JWT_KEY=
# Required on first initialization: 8–72 bytes; never printed to logs.
RUSTDESK_API_ADMIN_PASSWORD=
